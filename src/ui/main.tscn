[gd_scene format=3]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.035, 0.047, 0.067, 1)

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -90.0
offset_right = 360.0
offset_bottom = 90.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 18
alignment = 1

[node name="Title" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.82, 0.38, 1)
theme_override_font_sizes/font_size = 36
text = "GODOT GAME DESIGN STARTER"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.82, 0.88, 1)
theme_override_font_sizes/font_size = 18
text = "Replace this screen with the smallest playable question."
horizontal_alignment = 1

[node name="Hint" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.52, 0.59, 0.68, 1)
theme_override_font_sizes/font_size = 14
text = "Start in docs/game-rules.md and docs/vertical-slices.md"
horizontal_alignment = 1
